{
  "name": "listora-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "seed": "tsx --conditions=react-server --env-file=.env.local src/seed/seed.ts",
    "test:e2e": "playwright test",
    "cron": "node --env-file=.env.local scripts/cron.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.70.0",
    "mongoose": "^9.12.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
