MONGODB_URI=mongodb://localhost:27017/listora?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
SEED_PASSWORD=replace-with-a-password-for-the-seeded-accounts
# Guards the scheduled jobs that npm run cron calls.
CRON_SECRET=replace-with-at-least-16-random-characters

# Optional. Stripe test mode stays off until these are set. The webhook
# secret is only needed when Stripe can reach the server, through the
# Stripe CLI or a public address.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional. Photos go to this S3 bucket, with a key that can only reach it.
# Without them, adding a photo says storage isn't set up.
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
